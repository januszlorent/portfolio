* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #ffffff;
  color: #111111;
  line-height: 1.5;
}

header,
main {
  width: min(1200px, calc(100% - 40px));
  margin: 0 auto;
}

header {
  padding: 80px 0 60px;
}

h1 {
  margin: 0;
  font-size: clamp(42px, 7vw, 96px);
  line-height: 0.95;
  font-weight: 700;
}

header p {
  margin-top: 16px;
  font-size: 20px;
}

section {
  padding: 60px 0;
  border-top: 1px solid #dddddd;
}

h2 {
  margin-top: 0;
  font-size: 28px;
}

a {
  color: inherit;
  margin-right: 20px;
}

@media (max-width: 600px) {
  header,
  main {
    width: min(100% - 24px, 1200px);
  }

  header {
    padding: 50px 0 40px;
  }

  section {
    padding: 40px 0;
  }
}
